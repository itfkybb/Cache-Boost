# 仓库内统一使用 LF，检出时也保持 LF（跨平台与 WordPress 编码规范一致）
* text=auto eol=lf

# PHP / 文本
*.php   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.css   text eol=lf
*.js    text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf

# 二进制
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
